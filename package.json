{
    "name": "post-robot",
    "version": "12.1.0",
    "description": "Cross-window messaging over postMessage: send a request to a window, get a response, hand functions, promises and windows across and keep calling them.",
    "keywords": [
        "cross-domain",
        "cross-origin",
        "xdm",
        "iframe",
        "popup",
        "postmessage",
        "cugel"
    ],
    "homepage": "https://github.com/bluepnume/post-robot#readme",
    "bugs": {
        "url": "https://github.com/bluepnume/post-robot/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bluepnume/post-robot.git"
    },
    "license": "Apache-2.0",
    "author": "Daniel Brain",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=24"
    },
    "main": "./dist/src/index.js",
    "module": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "cugel-scripts build",
        "fix": "cugel-scripts fix --changed",
        "fix:all": "cugel-scripts fix",
        "imports:missing": "cugel-scripts imports:missing --changed",
        "lint": "cugel-scripts lint",
        "test:static": "cugel-scripts static",
        "test:unit": "cugel-scripts test --coverage",
        "test:watch": "cugel-scripts test --watch",
        "test": "npm run test:static && npm run test:unit && npm run build",
        "prepack": "npm run build"
    },
    "dependencies": {
        "cross-domain-utils": "^4.0.0",
        "sandestin": "^0.4.0",
        "zalgo-promise": "^3.0.0"
    },
    "devDependencies": {
        "cugel-scripts": "^0.1.0",
        "esbuild": "^0.28.0",
        "post-robot-previous": "npm:post-robot@^12.0.0"
    }
}
